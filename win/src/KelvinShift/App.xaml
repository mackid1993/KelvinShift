<Application
    x:Class="KelvinShift.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:KelvinShift"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <local:StringEqualsConverter   x:Key="StringEqualsConverter"/>
            <local:StringEqualsToVisibility x:Key="StringEqualsToVisibility"/>
            <local:NullToCollapsed          x:Key="NullToCollapsed"/>
            <local:BoolToVisibility         x:Key="BoolToVisibility"/>
            <local:InvertBool               x:Key="InvertBool"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<ui:FluentWindow
    x:Class="KelvinShift.Views.PreferencesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="KelvinShift"
    Width="500" Height="980"
    MinWidth="500" MinHeight="700"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="KelvinShift" Icon="pack://application:,,,/AppIcon.ico"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,8,20,20">
            <StackPanel>

                <!-- Color Temperature -->
                <ui:Card Margin="0,0,0,12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="🌡  Color Temperature" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Day" VerticalAlignment="Center"/>
                            <Slider x:Name="DayKSlider" Grid.Column="1"
                                    Minimum="2000" Maximum="6500" TickFrequency="100" IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.DayKelvin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PreviewMouseLeftButtonDown="DayK_Down"
                                    PreviewMouseLeftButtonUp="DayK_Up"
                                    Margin="8,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding Settings.DayKelvin, StringFormat={}{0} K}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="Recommended 5000–6500 K for daytime use"
                                   FontSize="11" Opacity="0.7" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Night" VerticalAlignment="Center"/>
                            <Slider x:Name="NightKSlider" Grid.Column="1"
                                    Minimum="1800" Maximum="5500" TickFrequency="100" IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.NightKelvin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PreviewMouseLeftButtonDown="NightK_Down"
                                    PreviewMouseLeftButtonUp="NightK_Up"
                                    Margin="8,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding Settings.NightKelvin, StringFormat={}{0} K}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="Recommended 2200–3000 K for nighttime use"
                                   FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                </ui:Card>

                <!-- Brightness -->
                <ui:Card Margin="0,0,0,12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="☀  Brightness" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Day" VerticalAlignment="Center"/>
                            <Slider x:Name="DayBSlider" Grid.Column="1"
                                    Minimum="0.1" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.DayBrightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PreviewMouseLeftButtonDown="DayB_Down"
                                    PreviewMouseLeftButtonUp="DayB_Up"
                                    Margin="8,0"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Settings.DayBrightness, StringFormat={}{0:P0}}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Night" VerticalAlignment="Center"/>
                            <Slider x:Name="NightBSlider" Grid.Column="1"
                                    Minimum="0.1" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.NightBrightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PreviewMouseLeftButtonDown="NightB_Down"
                                    PreviewMouseLeftButtonUp="NightB_Up"
                                    Margin="8,0"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Settings.NightBrightness, StringFormat={}{0:P0}}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="Dims the screen via gamma — does not affect backlight"
                                   FontSize="11" Opacity="0.7" Margin="0,8,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Bedtime -->
                <ui:Card Margin="0,0,0,12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="🛏  Bedtime" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <ui:ToggleSwitch IsChecked="{Binding Settings.BedtimeEnabled, Mode=TwoWay}"
                                         Content="Enable bedtime ramp" Margin="0,0,0,12"/>

                        <StackPanel IsEnabled="{Binding Settings.BedtimeEnabled}">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Bed K" VerticalAlignment="Center"/>
                                <Slider x:Name="BedKSlider" Grid.Column="1"
                                        Minimum="1000" Maximum="4000" TickFrequency="100" IsSnapToTickEnabled="True"
                                        Value="{Binding Settings.BedtimeKelvin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PreviewMouseLeftButtonDown="BedK_Down"
                                        PreviewMouseLeftButtonUp="BedK_Up"
                                        Margin="8,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding Settings.BedtimeKelvin, StringFormat={}{0} K}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,8,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Bed %" VerticalAlignment="Center"/>
                                <Slider x:Name="BedBSlider" Grid.Column="1"
                                        Minimum="0.1" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        Value="{Binding Settings.BedtimeBrightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PreviewMouseLeftButtonDown="BedB_Down"
                                        PreviewMouseLeftButtonUp="BedB_Up"
                                        Margin="8,0"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Settings.BedtimeBrightness, StringFormat={}{0:P0}}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="Bedtime:" VerticalAlignment="Center" Width="60"/>
                                <ui:NumberBox Value="{Binding Settings.BedtimeHour, Mode=TwoWay}" Minimum="0" Maximum="23"
                                              SpinButtonPlacementMode="Inline" Width="90"/>
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="6,0"/>
                                <ui:NumberBox Value="{Binding Settings.BedtimeMinute, Mode=TwoWay}" Minimum="0" Maximum="59"
                                              SpinButtonPlacementMode="Inline" Width="90"/>
                            </StackPanel>

                            <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,10,0,0"
                                       Text="After night settings are reached, the display slowly ramps to these warmer/dimmer bedtime values across the entire interval from night-start to your bedtime."/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- Schedule -->
                <ui:Card Margin="0,0,0,12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="🕒  Schedule" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton Content="Solar (sunrise / sunset)" GroupName="ScheduleMode"
                                         IsChecked="{Binding Settings.ScheduleMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=solar, Mode=TwoWay}"
                                         Margin="0,0,16,0"/>
                            <RadioButton Content="Custom times" GroupName="ScheduleMode"
                                         IsChecked="{Binding Settings.ScheduleMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=custom, Mode=TwoWay}"/>
                        </StackPanel>

                        <Grid Visibility="{Binding Settings.ScheduleMode, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=solar}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Latitude" FontSize="11" Opacity="0.7"/>
                                <ui:NumberBox Value="{Binding Settings.Latitude, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Longitude" FontSize="11" Opacity="0.7"/>
                                <ui:NumberBox Value="{Binding Settings.Longitude, Mode=TwoWay}"/>
                            </StackPanel>
                            <ui:Button Grid.Column="2" Content="Use Current"
                                       Icon="{ui:SymbolIcon Symbol=Location24}"
                                       Command="{Binding UseCurrentLocationCommand}"
                                       IsEnabled="{Binding IsLocating, Converter={StaticResource InvertBool}}"
                                       VerticalAlignment="Bottom"/>
                        </Grid>
                        <TextBlock Text="{Binding LocationError}" Foreground="OrangeRed" FontSize="11"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding LocationError, Converter={StaticResource NullToCollapsed}}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0"
                                    Visibility="{Binding Settings.ScheduleMode, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=custom}">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Day starts" FontSize="11" Opacity="0.7"/>
                                <StackPanel Orientation="Horizontal">
                                    <ui:NumberBox Value="{Binding Settings.CustomDayHour, Mode=TwoWay}" Minimum="0" Maximum="23" Width="80"/>
                                    <TextBlock Text=":" VerticalAlignment="Center" Margin="6,0"/>
                                    <ui:NumberBox Value="{Binding Settings.CustomDayMinute, Mode=TwoWay}" Minimum="0" Maximum="59" Width="80"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Night starts" FontSize="11" Opacity="0.7"/>
                                <StackPanel Orientation="Horizontal">
                                    <ui:NumberBox Value="{Binding Settings.CustomNightHour, Mode=TwoWay}" Minimum="0" Maximum="23" Width="80"/>
                                    <TextBlock Text=":" VerticalAlignment="Center" Margin="6,0"/>
                                    <ui:NumberBox Value="{Binding Settings.CustomNightMinute, Mode=TwoWay}" Minimum="0" Maximum="59" Width="80"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- Transition -->
                <ui:Card Margin="0,0,0,12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="↔  Transition" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:NumberBox Value="{Binding Settings.TransitionMinutes, Mode=TwoWay}" Minimum="1" Maximum="600" Width="100"/>
                            <TextBlock Text="minutes" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Duration of the smooth ramp between day and night temperatures"
                                   FontSize="11" Opacity="0.7" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="{Binding DemoButtonText}"
                                       Command="{Binding ToggleDemoCommand}" Width="140"/>
                            <ProgressBar Width="180" Margin="12,0" Value="{Binding DemoProgress}" Maximum="1"
                                         Visibility="{Binding IsDemoRunning, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding DemoProgressPercent, StringFormat={}{0}%}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsDemoRunning, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                        <TextBlock Text="Runs through a full day/night cycle in 10 seconds"
                                   FontSize="11" Opacity="0.7" Margin="0,8,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- General -->
                <ui:Card Margin="0,0,0,12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="⚙  General" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <ui:ToggleSwitch IsChecked="{Binding Settings.Enabled, Mode=TwoWay}" Content="Enabled" Margin="0,0,0,8"/>
                        <ui:ToggleSwitch IsChecked="{Binding Settings.LaunchAtLogin, Mode=TwoWay}" Content="Start with Windows"/>
                    </StackPanel>
                </ui:Card>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>

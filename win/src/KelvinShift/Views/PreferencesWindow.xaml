<ui:FluentWindow
    x:Class="KelvinShift.Views.PreferencesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:vm="clr-namespace:KelvinShift.ViewModels"
    Title="KelvinShift"
    Width="620" Height="980"
    MinWidth="560" MinHeight="700"
    WindowStyle="None"
    ResizeMode="CanResize"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    Icon="pack://application:,,,/AppIcon.ico"
    Background="Transparent">

    <!-- WPF-UI's Mica backdrop requires ExtendsContentIntoTitleBar=True,
         which in turn requires a ui:TitleBar to provide the visible chrome. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="KelvinShift">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/AppIcon.ico" Width="16" Height="16">
                    <ui:ImageIcon.Clip>
                        <RectangleGeometry Rect="0,0,16,16" RadiusX="3.5" RadiusY="3.5"/>
                    </ui:ImageIcon.Clip>
                </ui:ImageIcon>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,8,20,20">
            <StackPanel Grid.IsSharedSizeScope="True">

                <!-- Color Temperature -->
                <ui:Card Margin="0,0,0,12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="🌡  Color Temperature" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <Grid Height="40" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Day" VerticalAlignment="Center"/>
                            <Slider x:Name="DayKSlider" Grid.Column="1"
                                    Minimum="1000" Maximum="6500" TickFrequency="50" IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.DayKelvin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PreviewMouseLeftButtonDown="DayK_Down"
                                    PreviewMouseLeftButtonUp="DayK_Up"
                                    Margin="8,0" FocusVisualStyle="{x:Null}"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBox Text="{Binding Settings.DayKelvin, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="60" TextAlignment="Right"
                                         KeyDown="NumericTextBox_KeyDown" GotFocus="NumericTextBox_GotFocus" PreviewMouseLeftButtonDown="NumericTextBox_PreviewMouseLeftButtonDown"/>
                                <TextBlock Text=" K" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Height="40" Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Night" VerticalAlignment="Center"/>
                            <Slider x:Name="NightKSlider" Grid.Column="1"
                                    Minimum="1000" Maximum="6500" TickFrequency="50" IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.NightKelvin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PreviewMouseLeftButtonDown="NightK_Down"
                                    PreviewMouseLeftButtonUp="NightK_Up"
                                    Margin="8,0" FocusVisualStyle="{x:Null}"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBox Text="{Binding Settings.NightKelvin, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="60" TextAlignment="Right"
                                         KeyDown="NumericTextBox_KeyDown" GotFocus="NumericTextBox_GotFocus" PreviewMouseLeftButtonDown="NumericTextBox_PreviewMouseLeftButtonDown"/>
                                <TextBlock Text=" K" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Height="40" Margin="0,8,0,4" Visibility="{Binding Settings.BedtimeEnabled, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Bed" VerticalAlignment="Center"/>
                            <Slider x:Name="BedKSlider" Grid.Column="1"
                                    Minimum="1000" Maximum="6500" TickFrequency="50" IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.BedtimeKelvin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PreviewMouseLeftButtonDown="BedK_Down"
                                    PreviewMouseLeftButtonUp="BedK_Up"
                                    Margin="8,0" FocusVisualStyle="{x:Null}"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBox Text="{Binding Settings.BedtimeKelvin, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="60" TextAlignment="Right"
                                         KeyDown="NumericTextBox_KeyDown" GotFocus="NumericTextBox_GotFocus" PreviewMouseLeftButtonDown="NumericTextBox_PreviewMouseLeftButtonDown"/>
                                <TextBlock Text=" K" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </ui:Card>

                <!-- Brightness -->
                <ui:Card Margin="0,0,0,12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="☀  Brightness" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <Grid Height="40" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Day" VerticalAlignment="Center"/>
                            <Slider x:Name="DayBSlider" Grid.Column="1"
                                    Minimum="0.1" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.DayBrightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PreviewMouseLeftButtonDown="DayB_Down"
                                    PreviewMouseLeftButtonUp="DayB_Up"
                                    Margin="8,0" FocusVisualStyle="{x:Null}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Settings.DayBrightness, StringFormat={}{0:P0}}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Height="40" Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Night" VerticalAlignment="Center"/>
                            <Slider x:Name="NightBSlider" Grid.Column="1"
                                    Minimum="0.1" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.NightBrightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PreviewMouseLeftButtonDown="NightB_Down"
                                    PreviewMouseLeftButtonUp="NightB_Up"
                                    Margin="8,0" FocusVisualStyle="{x:Null}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Settings.NightBrightness, StringFormat={}{0:P0}}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Height="40" Margin="0,8,0,4" Visibility="{Binding Settings.BedtimeEnabled, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Bed" VerticalAlignment="Center"/>
                            <Slider x:Name="BedBSlider" Grid.Column="1"
                                    Minimum="0.1" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.BedtimeBrightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PreviewMouseLeftButtonDown="BedB_Down"
                                    PreviewMouseLeftButtonUp="BedB_Up"
                                    Margin="8,0" FocusVisualStyle="{x:Null}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Settings.BedtimeBrightness, StringFormat={}{0:P0}}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="Dims the screen via gamma — does not affect backlight"
                                   FontSize="11" Opacity="0.7" Margin="0,8,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Schedule -->
                <ui:Card Margin="0,0,0,12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="🕒  Schedule" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton Content="Solar (sunrise / sunset)" GroupName="ScheduleMode"
                                         IsChecked="{Binding Settings.ScheduleMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=solar, Mode=TwoWay}"
                                         Margin="0,0,16,0"/>
                            <RadioButton Content="Custom times" GroupName="ScheduleMode"
                                         IsChecked="{Binding Settings.ScheduleMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=custom, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding Settings.ScheduleMode, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=solar}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Latitude" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                                    <ui:NumberBox Value="{Binding Settings.Latitude, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Longitude" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                                    <ui:NumberBox Value="{Binding Settings.Longitude, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>
                            <ui:Button Content="Use Current Location"
                                       Icon="{ui:SymbolIcon Symbol=Location24}"
                                       Command="{Binding UseCurrentLocationCommand}"
                                       IsEnabled="{Binding IsLocating, Converter={StaticResource InvertBool}}"
                                       HorizontalAlignment="Left"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LocationError}" Foreground="OrangeRed" FontSize="11"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding LocationError, Converter={StaticResource NullToCollapsed}}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0"
                                    Visibility="{Binding Settings.ScheduleMode, Converter={StaticResource StringEqualsToVisibility}, ConverterParameter=custom}">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Day starts" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox ItemsSource="{x:Static vm:PreferencesViewModel.Hours12}"
                                              SelectedItem="{Binding DayHour12, Mode=TwoWay}" Width="90" MinWidth="90"/>
                                    <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0"/>
                                    <ComboBox ItemsSource="{x:Static vm:PreferencesViewModel.Minutes}"
                                              SelectedItem="{Binding DayMinute, Mode=TwoWay}" Width="70">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat={}{0:D2}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox ItemsSource="{x:Static vm:PreferencesViewModel.AmPmOptions}"
                                              SelectedItem="{Binding DayAmPm, Mode=TwoWay}" Width="90" MinWidth="90" Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Night starts" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox ItemsSource="{x:Static vm:PreferencesViewModel.Hours12}"
                                              SelectedItem="{Binding NightHour12, Mode=TwoWay}" Width="90" MinWidth="90"/>
                                    <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0"/>
                                    <ComboBox ItemsSource="{x:Static vm:PreferencesViewModel.Minutes}"
                                              SelectedItem="{Binding NightMinute, Mode=TwoWay}" Width="70">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat={}{0:D2}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox ItemsSource="{x:Static vm:PreferencesViewModel.AmPmOptions}"
                                              SelectedItem="{Binding NightAmPm, Mode=TwoWay}" Width="90" MinWidth="90" Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <Separator Margin="0,16,0,12"/>

                        <ui:ToggleSwitch IsChecked="{Binding Settings.BedtimeEnabled, Mode=TwoWay}"
                                         Content="🛏  Enable bedtime ramp" Margin="0,0,0,8"/>
                        <StackPanel Visibility="{Binding Settings.BedtimeEnabled, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Bedtime" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{x:Static vm:PreferencesViewModel.Hours12}"
                                          SelectedItem="{Binding BedtimeHour12, Mode=TwoWay}" Width="90" MinWidth="90"/>
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0"/>
                                <ComboBox ItemsSource="{x:Static vm:PreferencesViewModel.Minutes}"
                                          SelectedItem="{Binding BedtimeMinute, Mode=TwoWay}" Width="70">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat={}{0:D2}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox ItemsSource="{x:Static vm:PreferencesViewModel.AmPmOptions}"
                                          SelectedItem="{Binding BedtimeAmPm, Mode=TwoWay}" Width="90" MinWidth="90" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,8,0,0"
                                   Visibility="{Binding Settings.BedtimeEnabled, Converter={StaticResource BoolToVisibility}}"
                                   Text="After the night setting is reached, the display ramps to the Bed temperature/brightness above. Ramp duration is under Transitions."/>
                    </StackPanel>
                </ui:Card>

                <!-- Transitions -->
                <ui:Card Margin="0,0,0,12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="↔  Transitions" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <Grid Height="32" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Day↔Night" VerticalAlignment="Center" FontSize="11" Opacity="0.85"/>
                            <Slider Grid.Column="1"
                                    Minimum="1" Maximum="180" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.TransitionMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center" Margin="8,0" FocusVisualStyle="{x:Null}"/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Text="{Binding Settings.TransitionMinutes, StringFormat={}{0} min}"/>
                        </Grid>

                        <Grid Height="32" Margin="0,8,0,8"
                              Visibility="{Binding Settings.BedtimeEnabled, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Night→Bed" VerticalAlignment="Center" FontSize="11" Opacity="0.85"/>
                            <Slider Grid.Column="1"
                                    Minimum="1" Maximum="180" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.BedtimeRampMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center" Margin="8,0" FocusVisualStyle="{x:Null}"/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Text="{Binding Settings.BedtimeRampMinutes, StringFormat={}{0} min}"/>
                        </Grid>
                        <TextBlock Text="Smooth Hermite ramp between phases. Bedtime ramp is clamped to the night→bedtime window if too long."
                                   FontSize="11" Opacity="0.7" Margin="0,4,0,12" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="{Binding DemoButtonText}"
                                       Command="{Binding ToggleDemoCommand}" Width="140"/>
                            <ProgressBar Width="180" Margin="12,0"
                                         Value="{Binding DemoProgress, Mode=OneWay}" Maximum="1"
                                         Visibility="{Binding IsDemoRunning, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding DemoProgressPercent, StringFormat={}{0}%}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsDemoRunning, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                        <TextBlock Text="Runs through a full day/night cycle in 10 seconds"
                                   FontSize="11" Opacity="0.7" Margin="0,8,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- General -->
                <ui:Card Margin="0,0,0,12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="⚙  General" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <ui:ToggleSwitch IsChecked="{Binding Settings.Enabled, Mode=TwoWay}" Content="Enabled" Margin="0,0,0,8"/>
                        <ui:ToggleSwitch IsChecked="{Binding Settings.LaunchAtLogin, Mode=TwoWay}" Content="Start with Windows" Margin="0,0,0,12"/>

                        <Separator Margin="0,4,0,12"/>

                        <ui:ToggleSwitch IsChecked="{Binding ExtendedRangeEnabled, Mode=TwoWay}"
                                         Content="Allow warm temperatures below 3500K"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,4,0,0"
                                   Text="Optional. Writes a system registry value (UAC prompt) that lifts Windows' default gamma-range cap. Only matters for the gamma-ramp fallback path. Requires sign-out / reboot."/>
                        <TextBlock Text="{Binding ExtendedRangeStatus}" FontSize="11" Opacity="0.85"
                                   Foreground="{DynamicResource SystemAccentColorBrush}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding ExtendedRangeStatus, Converter={StaticResource NullToCollapsed}}"/>
                    </StackPanel>
                </ui:Card>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>

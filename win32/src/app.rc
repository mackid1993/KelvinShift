#include <windows.h>
#include "resource.h"

// Application icon — embedded in the PE header and loadable at runtime.
IDI_APPICON ICON "AppIcon.ico"

// Application manifest (RT_MANIFEST = 24). ID 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID.
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    2,0,1,0
 PRODUCTVERSION 2,0,1,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "David Brustein"
            VALUE "FileDescription",  "KelvinShift"
            VALUE "FileVersion",      "2.0.1.0"
            VALUE "InternalName",     "KelvinShift"
            VALUE "OriginalFilename", "KelvinShift.exe"
            VALUE "ProductName",      "KelvinShift"
            VALUE "ProductVersion",   "2.0.1.0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 David Brustein"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
